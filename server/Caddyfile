# Integration example for MyCollabAdvanced/deploy/Caddyfile.
# Merge with the deployed file; do not discard other custom routes.
# DOMAIN is supplied by the existing MyCollab Caddy container: public IPv4 only.
{
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	encode gzip

	# Keep /sub intact; handle_path would strip the prefix required by the app.
	handle /sub/* {
		reverse_proxy clash-subscription:8080
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle /static/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
